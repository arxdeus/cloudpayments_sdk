# The CloudPayments iOS SDK requires iOS 15.0.
platform :ios, '15.0'

# CocoaPods analytics sends network stats, which slows down the build.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # ---------------------------------------------------------------------------
  # REQUIRED for cloudpayments_sdk.
  #
  # The official CloudPayments iOS SDK is not published to the CocoaPods trunk,
  # and a plugin's podspec cannot point a dependency at a git repository — so
  # these two lines have to live in the app's Podfile.
  #
  # The podspec inside the repository still names github.com as its source, and
  # that repository is archived at 1.3.3; the `:git` override below is what
  # makes 2.x resolve.
  # ---------------------------------------------------------------------------
  cloudpayments_sdk_version = '2.1.6'
  cloudpayments_sdk_git = 'https://gitpub.cloudpayments.ru/integrations/sdk/cloudpayments-ios.git'

  pod 'Cloudpayments', :git => cloudpayments_sdk_git, :tag => cloudpayments_sdk_version
  pod 'CloudpaymentsNetworking', :git => cloudpayments_sdk_git, :tag => cloudpayments_sdk_version

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Nothing below 15.0 can link the CloudPayments SDK.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
